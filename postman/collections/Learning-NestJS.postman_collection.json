        {
          "name": "👤 Get Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "auth",
                "me"
              ]
            },
            "description": "### 👤 Get Current User Profile (Me)\nFetches the authenticated user's profile using the JWT token passed in the Authorization header.\n\n* **Method:** GET\n* **URL:** {{baseUrl}}/users/auth/me\n* **Header:** Authorization: Bearer <token>\n* **Throws:** 401 Unauthorized if token is missing, invalid, or expired."
          },
          "response": []
        },
        {
          "name": "👥 Get All Users (Admin Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "auth"
              ]
            },
            "description": "### 👥 Get All Users (Admin Only)\nRetrieves a list of all registered users. Restricted to users with the `admin` role.\n\n* **Method:** `GET`\n* **URL:** `{{baseUrl}}/users/auth`\n* **Header:** `Authorization: Bearer <token>`\n* **Access:** Admin only (`@Roles(UserType.ADMIN)`)\n* **Throws:**\n  * `401 Unauthorized` if token is missing or invalid.\n  * `403 Forbidden` if authenticated user is not an Admin."
          },
          "response": []
        },
