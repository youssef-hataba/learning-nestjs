            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"youssef_dev\",\n  \"email\": \"youssef@example.com\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\"\n}",
              "options": {
