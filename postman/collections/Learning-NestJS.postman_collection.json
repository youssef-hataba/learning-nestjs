              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "auth",
                "login"
