FROM node:24-alpine

WORKDIR /app

# Install all dependencies
COPY package*.json ./
RUN npm install

# Copy application source code
COPY . .

# Enable polling for reliable file change detection across Docker on Windows
ENV WATCHPACK_POLLING=true
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

EXPOSE 3000

# Start Next.js dev server bound to 0.0.0.0 on port 3000
CMD ["npx", "next", "dev", "-H", "0.0.0.0", "-p", "3000"]
